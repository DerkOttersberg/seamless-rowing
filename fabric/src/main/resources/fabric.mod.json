{
  "schemaVersion": 1,
  "id": "seamlessrowing",
  "version": "${version}",
  "name": "Seamless Rowing",
  "description": "Hands follow the boat paddles with articulated arms, smooth recovery and natural shoulder movement. Client-only animation preview.",
  "authors": [
    "Derk Ottersberg"
  ],
  "license": "All Rights Reserved",
  "environment": "client",
  "icon": "assets/seamlessrowing/icon.png",
  "entrypoints": {
    "client": [
      "io.github.derkottersberg.seamlessrowing.fabric.RowingFabricClient"
    ],
    "modmenu": [
      "io.github.derkottersberg.seamlessrowing.fabric.RowingModMenu"
    ]
  },
  "mixins": [
    "seamlessrowing.mixins.json",
    "seamlessrowing.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.116.17 <0.117.0",
    "minecraft": "1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": ">=11.0.5 <12.0.0"
  },
  "accessWidener": "seamlessrowing.accesswidener"
